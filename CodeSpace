package Rent_A_Car_System;

public class Car {
	private String plaka;
	private double gunlukUcret;
	private int kilometre;
	private boolean isMusait;
	private boolean bakimGerekiyorMu;
	public Car(String plaka, double gunlukUcret2 ) {
		
		this.plaka = plaka;
		this.gunlukUcret = gunlukUcret2;
		this.kilometre = kilometre=0;
		this.isMusait = isMusait=true;
		this.bakimGerekiyorMu = bakimGerekiyorMu=false;
	}
	
public double kiralamaUcretiHesapla(int gun) {
	return gun*gunlukUcret;
}

public boolean aracKirala() {
	if(isMusait && !bakimGerekiyorMu){
		isMusait=false;
		System.out.println(plaka+" Kiralandı");
		return true;
		}else {
			System.out.println("Hata! "+plaka+" Kiralanamaz (Bakım: "+bakimGerekiyorMu+" , Müsait: "+isMusait+")");
			return false;
		}
	
}

public void araciTeslimAl(int yapilanKm) {
	
	this.kilometre+=yapilanKm;
	this.isMusait=true;
	if(this.kilometre%10000<yapilanKm) {
		this.bakimGerekiyorMu=true;
		System.out.println(plaka+" Bakım zamanı geldi");
	}
	
}

public void bakımYap() {
	this.bakimGerekiyorMu=false;
	System.out.println(plaka+" Bakımı yapıldı");
}

public String getPlaka() {
	return plaka;
}

public double getGunlukUcret() {
	return gunlukUcret;
}

public int getKilometre() {
	return kilometre;
}

public boolean isMusait() {
	return isMusait;
}

public boolean isBakimGerekiyorMu() {
	return bakimGerekiyorMu;
}

public void setPlaka(String plaka) {
	this.plaka = plaka;
}

public void setGunlukUcret(int gunlukUcret) {
	this.gunlukUcret = gunlukUcret;
}

public void setKilometre(int kilometre) {
	this.kilometre = kilometre;
}

public void setMusait(boolean isMusait) {
	this.isMusait = isMusait;
}

public void setBakimGerekiyorMu(boolean bakimGerekiyorMu) {
	this.bakimGerekiyorMu = bakimGerekiyorMu;
}
}




public class SportsCar extends Car{

	public SportsCar(String plaka, double gunlukUcret) {
		super(plaka, gunlukUcret);
		
	}

	@Override
	public double kiralamaUcretiHesapla(int gun) {
		// TODO Auto-generated method stub
		return (super.kiralamaUcretiHesapla(gun)*2)+500;
	}

	@Override
	public void araciTeslimAl(int yapilanKm) {
		
		super.araciTeslimAl(yapilanKm);
		if(getKilometre()%3000>yapilanKm&&!isBakimGerekiyorMu()) {
			System.out.println(getPlaka() +"Aracın bakım zamanı geldi...");
			setBakimGerekiyorMu(true);
		}
	}
	

}


public class Truck extends Car{

	public Truck(String plaka, double gunlukUcret2) {
		super(plaka, gunlukUcret2);
		
	}

	
	public double kiralamaUcretiHesapla(int gun) {
		if(gun>7) {
			return (super.kiralamaUcretiHesapla(gun)*0.8);
		}
		return super.kiralamaUcretiHesapla(gun);
	}

	@Override
	public void araciTeslimAl(int yapilanKm) {
		// TODO Auto-generated method stub
		super.araciTeslimAl(yapilanKm);
	}

	
}



